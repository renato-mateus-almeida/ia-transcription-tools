# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env && chmod 600 .env

# Token "Read" do Hugging Face (https://huggingface.co/settings/tokens).
# A conta precisa ter aceitado os termos de:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Opcional: pasta base das transcrições (padrão: ~/Transcricoes).
# TRANSCRICOES_DIR=~/Transcricoes

# Por padrão a transcrição roda sem acessar a rede (modelos já baixados em ~/.cache/huggingface).
# Descomente só para baixar modelos (primeira instalação ou troca de modelo) e volte a comentar.
# HF_HUB_OFFLINE=0
